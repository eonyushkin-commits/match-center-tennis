{
  "name": "match-center-tennis",
  "productName": "Матч-центр Теннис",
  "version": "1.0.6",
  "description": "Матч-центр по теннису: расписание и счёт ATP и WTA из ESPN, трансляции из VK Видео",
  "main": "src/electron/main.cjs",
  "type": "commonjs",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "app": "node scripts/electron.mjs .",
    "test": "node --test \"test/*.test.mjs\"",
    "smoke": "node scripts/smoke.mjs",
    "dist": "electron-builder --win --publish never"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "linkedom": "^0.18.13"
  },
  "build": {
    "appId": "ru.sportcenter.tenniscenter",
    "productName": "Матч-центр Теннис",
    "files": [
      "src/**",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "icon": "src/assets/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "tennis-center-${version}-setup.${ext}",
      "shortcutName": "Матч-центр Теннис"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "eonyushkin-commits",
        "repo": "match-center-tennis"
      }
    ]
  },
  "allowScripts": {
    "electron@44.4.4": true,
    "electron-winstaller@5.4.0": true
  }
}
